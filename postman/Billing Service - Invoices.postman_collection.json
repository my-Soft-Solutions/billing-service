{
  "info": {
    "_postman_id": "2546164a-9c4a-4470-a57d-7128ef017b18",
    "name": "Billing Service - Invoices",
    "description": "Invoice API requests for the Billing Service. Set token and clientId before creating an invoice. Server configuration: MAIN_API_URL must point to the client API for client verification, and INVOICE_EMAIL_API_URL must point to the email-sending API. The request order supports a create, update, issue, email, and cancel lifecycle.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Invoices",
      "item": [
        {
          "name": "Create invoice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": \"{{clientId}}\",\n  \"currency\": \"LKR\",\n  \"discount_amount\": \"0.00\",\n  \"tax_amount\": \"0.00\",\n  \"notes\": \"Invoice created from Postman\",\n  \"items\": [\n    {\n      \"description\": \"Legal consultation\",\n      \"billing_type\": \"hourly\",\n      \"quantity\": \"2.00\",\n      \"unit_price\": \"5000.00\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/invoices",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "invoices"
              ]
            },
            "description": "Creates a draft invoice and saves its ID to the invoiceId collection variable. clientId must belong to the authenticated law firm."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invoice created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    const invoice = pm.response.json();",
                  "    if (invoice.id) pm.collectionVariables.set('invoiceId', invoice.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List invoices",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/invoices?page=1&limit=20&status=draft",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "invoices"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "status",
                  "value": "draft",
                  "description": "Optional: draft, issued, partially_paid, paid, overdue, or cancelled."
                }
              ]
            },
            "description": "Lists invoices for the authenticated law firm with pagination and optional status filtering."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invoices listed', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const result = pm.response.json();",
                  "    pm.test('List response has data and pagination', function () {",
                  "        pm.expect(result.data).to.be.an('array');",
                  "        pm.expect(result.pagination).to.be.an('object');",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get invoice",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/invoices/{{invoiceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "invoices",
                "{{invoiceId}}"
              ]
            },
            "description": "Gets an invoice, including its line items and email-sent fields."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invoice retrieved', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update draft invoice",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency\": \"LKR\",\n  \"discount_amount\": \"250.00\",\n  \"tax_amount\": \"0.00\",\n  \"notes\": \"Updated invoice notes\",\n  \"items\": [\n    {\n      \"description\": \"Legal consultation\",\n      \"billing_type\": \"hourly\",\n      \"quantity\": \"2.00\",\n      \"unit_price\": \"5000.00\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/invoices/{{invoiceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "invoices",
                "{{invoiceId}}"
              ]
            },
            "description": "Updates an invoice while it is in draft status. Items are replaced when included in the request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Draft invoice updated', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Download invoice PDF",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/pdf"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/invoices/{{invoiceId}}/pdf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "invoices",
                "{{invoiceId}}",
                "pdf"
              ]
            },
            "description": "Downloads the invoice as a PDF attachment."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invoice PDF downloaded', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Issue invoice",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/invoices/{{invoiceId}}/issue",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "invoices",
                "{{invoiceId}}",
                "issue"
              ]
            },
            "description": "Issues a draft invoice with at least one line item."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invoice issued', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    pm.test('Invoice status is issued', function () {",
                  "        pm.expect(pm.response.json().status).to.eql('issued');",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Send invoice email",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/invoices/{{invoiceId}}/send-email",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "invoices",
                "{{invoiceId}}",
                "send-email"
              ]
            },
            "description": "Sends an active invoice to its client with the invoice PDF attached through the server-configured INVOICE_EMAIL_API_URL. Draft, cancelled, or already emailed invoices cannot be sent."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invoice email sent', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const invoice = pm.response.json();",
                  "    pm.test('Invoice is marked as sent', function () {",
                  "        pm.expect(invoice.email_sent).to.eql(true);",
                  "        pm.expect(invoice.email_sent_at).to.be.ok;",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel invoice",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/invoices/{{invoiceId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "invoices",
                "{{invoiceId}}",
                "cancel"
              ]
            },
            "description": "Cancels an invoice unless it is already paid or cancelled."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invoice cancelled', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    pm.test('Invoice status is cancelled', function () {",
                  "        pm.expect(pm.response.json().status).to.eql('cancelled');",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "clientId",
      "value": ""
    },
    {
      "key": "invoiceId",
      "value": ""
    }
  ]
}
